{
 "name": "ffrwd/moq",
 "version": "0.5.1",
 "description": "Media over QUIC - publish a query's streams TO a relay broadcast, and subscribe to one as a FROM relation. Publishing packages each encoded stream as fragmented MP4 and a hang catalog naming the renditions with their init segments.",
 "license": "Apache-2.0",
 "homepage": "https://github.com/imbcmdth/ffrwd-package-moq",
 "capabilities": [
  "udp",
  "http"
 ],
 "dependencies": {
  "ffrwd/wasm": "0.15.0"
 },
 "keywords": [
  "fmp4",
  "live",
  "moq",
  "publish",
  "quic",
  "relay",
  "streaming",
  "subscribe"
 ],
 "lib": {
  "publish": "src/moq.sql",
  "subscribe": "src/moq.sql"
 },
 "bin": {
  "publish": "recipes/publish.sql",
  "publish-live": "recipes/publish-live.sql",
  "publish-ladder": "recipes/publish-ladder.sql",
  "republish-ladder": "recipes/republish-ladder.sql",
  "subscribe": "recipes/subscribe.sql",
  "subscribe-widest": "recipes/subscribe-widest.sql",
  "relay": "recipes/relay.sql"
 }
}
